# SITE_ADDRESS defaults to :80 (plain HTTP). In production it is always :80: the shared edge
# proxy terminates TLS and forwards to this container as tablebot-web:80.
{
	servers {
		# Keep the client IP and X-Forwarded-Proto set by the edge proxy (Docker networks are private).
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Hashed build assets can be cached forever; everything else (notably
		# index.html, served for every SPA route) must be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# SPA history-mode fallback.
		try_files {path} /index.html
		file_server
	}
}
