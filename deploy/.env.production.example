# Production settings for the server. Copy to /opt/tablebot/.env, fill in, then: chmod 600 .env
# Never commit the filled-in file. docs/deploy.md step 3 walks through it.

# Must be "prod" on the server: turns off the dev login.
APP_ENV=prod
# debug | info | warn | error
LOG_LEVEL=info

# Database. Generate the password with: openssl rand -hex 24
# No DATABASE_URL here: docker compose builds it from these values.
POSTGRES_USER=tablebot
POSTGRES_DB=tablebot
POSTGRES_PASSWORD=CHANGE_ME

# Token of the PRODUCTION bot from @BotFather (not the dev bot on your laptop).
BOT_TOKEN=CHANGE_ME
# Public HTTPS address of the app; the bot sets its menu button to it.
WEBAPP_URL=https://<host>
# Domain Caddy gets the HTTPS certificate for: no https://, no trailing slash.
SITE_ADDRESS=<host>

# Minutes a new request holds the table before it expires.
HOLD_MINUTES=15
# How often the worker runs, and how early reminders go out (Go durations).
REMINDER_INTERVAL=1m
REMINDER_BEFORE=2h
# How long shutdown waits for running requests and messages.
SHUTDOWN_TIMEOUT=10s
